# Copy to /etc/mbfd/obs-fixed-compositor.env with mode 0600.
# Never commit the populated file.
OBS_CAMERA_RTSP_URL=rtsp://PRIVATE_CAMERA_ADDRESS/stream
LIVE_PROGRAM_RECEIVER_URL=http://127.0.0.1:3000/player/live-stream
OBS_WEBSOCKET_BIND=127.0.0.1
OBS_WEBSOCKET_PORT=4455
OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
OBS_WEBSOCKET_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_RUNTIME_SECRET
# Required: populate with the encoder ID proven by the bounded host benchmark.
OBS_H264_ENCODER=
OBS_VIDEO_BITRATE_KBPS=6000
OBS_AUDIO_BITRATE_KBPS=160
PEERTUBE_RTMP_SERVER=rtmp://PRIVATE_PEERTUBE_ADDRESS/live
PEERTUBE_STREAM_KEY=REPLACE_WITH_THE_PROTECTED_RUNTIME_STREAM_KEY
