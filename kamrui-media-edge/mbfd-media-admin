#!/usr/bin/env bash
# /usr/local/sbin/mbfd-media-admin
# Least-privilege media administration helper for the `peter` user.
#
# Owned by root:root, NOT writable by peter. Allows only a fixed allowlist of
# subcommands. Never executes a shell supplied by the caller and never passes
# arbitrary arguments to privileged operations. Intended to be invoked via a
# narrow sudoers entry:
#   peter ALL=(root) NOPASSWD: /usr/local/sbin/mbfd-media-admin
#
# Allowlisted subcommands:
#   restart-camera-api        systemctl restart mbfd-camera-api
#   restart-mediamtx          docker restart mbfd-mediamtx
#   retire-legacy-relays      disable and remove obsolete non-Anpviz relays
#   reload-mediamtx-config    docker exec mbfd-mediamtx kill -HUP 1
#   status                    systemctl status of all media services + docker
#   ufw-apply                 re-apply the approved fixed Kamrui firewall rules
#   ufw-allow-guest-rtmp      add only the exact guest -> KAMRUI RTMP rule
#   ufw-revoke-guest-rtmp     remove only that exact guest -> KAMRUI RTMP rule
#   ufw-show                  ufw status numbered
set -euo pipefail

ALLOWED="restart-camera-api restart-mediamtx reload-mediamtx-config retire-legacy-relays status ufw-apply ufw-allow-guest-rtmp ufw-revoke-guest-rtmp ufw-show"
CAMERA_ENV_FILE=/etc/mbfd/media-stack/camera.env

read_camera_env_value() {
  local key="$1"
  sed -n -E "s/^${key}=//p" "$CAMERA_ENV_FILE" | tail -n 1 | tr -d '\r'
}

is_ipv4() {
  local address="$1"
  local first second third fourth extra octet
  [[ "$address" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
  IFS=. read -r first second third fourth extra <<< "$address"
  [ -z "${extra:-}" ] || return 1
  for octet in "$first" "$second" "$third" "$fourth"; do
    [[ "$octet" =~ ^[0-9]{1,3}$ ]] || return 1
    [ "$octet" -le 255 ] 2>/dev/null || return 1
  done
}

if [ $# -ne 1 ]; then
  echo "usage: mbfd-media-admin <subcommand>" >&2
  echo "allowed: $ALLOWED" >&2
  exit 2
fi
cmd="$1"
case "$cmd" in
  restart-camera-api)        exec systemctl restart mbfd-camera-api ;;
  restart-mediamtx)          exec docker restart mbfd-mediamtx ;;
  reload-mediamtx-config)    exec docker exec mbfd-mediamtx sh -c 'kill -HUP 1' ;;
  retire-legacy-relays)
    systemctl disable --now mbfd-annke-main-relay mbfd-annke-preview-relay 2>/dev/null || true
    rm -f /etc/systemd/system/mbfd-annke-main-relay.service \
      /etc/systemd/system/mbfd-annke-preview-relay.service \
      /opt/mbfd/media-stack/annke-main-relay.sh \
      /opt/mbfd/media-stack/annke-preview-relay.sh
    systemctl daemon-reload
    systemctl reset-failed mbfd-annke-main-relay mbfd-annke-preview-relay 2>/dev/null || true
    ;;
  status)
    for s in mbfd-camera-api; do
      echo "=== $s ==="
      systemctl is-active "$s" || true
      systemctl is-enabled "$s" 2>/dev/null || true
    done
    echo "=== mediamtx container ==="
    docker ps --filter name=mbfd-mediamtx --format '{{.Names}} {{.Status}}' || true
    ;;
  ufw-apply)
    # Approved fixed rules: deny by default; allow SSH from LAN+Tailscale;
    # allow only the exact controller/publisher identities to reach media ports.
    ufw --force reset >/dev/null 2>&1
    ufw default deny incoming
    ufw default allow outgoing
    ufw allow in on tailscale0 to any port 22 proto tcp
    ufw allow in from 192.168.1.0/24 to any port 22 proto tcp
    ufw allow in from 100.82.185.48 to any port 22 proto tcp
    ufw allow in from 192.168.1.116 to any port 8200 proto tcp
    ufw allow in from 192.168.1.116 to any port 8888 proto tcp
    # GMKtec OBS consumes the canonical RTSP program input.
    ufw allow in from 192.168.1.116 to any port 8554 proto tcp
    # The P3 publishes the canonical Anpviz/TONOR stream and heartbeat. Permit
    # only its established LAN and Tailscale identities, never the whole subnet.
    ufw allow in from 192.168.1.101 to any port 8200 proto tcp
    ufw allow in from 100.123.92.37 to any port 8200 proto tcp
    ufw allow in from 192.168.1.101 to any port 8554 proto tcp
    ufw allow in from 100.123.92.37 to any port 8554 proto tcp
    ufw --force enable
    ufw status verbose
    ;;
  ufw-allow-guest-rtmp)
    # Do not call `ufw reset` here. This narrowly adds the staged OBS source
    # rule and is safe to inspect before a controlled MediaMTX recreation.
    guest_ip="$(read_camera_env_value GUEST_RTMP_PUBLISHER_LAN_IP)"
    kamrui_ip="$(read_camera_env_value KAMRUI_LAN_IP)"
    if ! is_ipv4 "$guest_ip" || ! is_ipv4 "$kamrui_ip"; then
      echo "camera.env is missing a valid guest or KAMRUI LAN IPv4 for RTMP" >&2
      exit 1
    fi
    ufw allow in from "$guest_ip" to "$kamrui_ip" port 1935 proto tcp
    ufw status numbered
    ;;
  ufw-revoke-guest-rtmp)
    # Call this before restoring a pre-guest MediaMTX configuration. It only
    # removes the exact rule added above and never resets or changes any other
    # firewall policy.
    guest_ip="$(read_camera_env_value GUEST_RTMP_PUBLISHER_LAN_IP)"
    kamrui_ip="$(read_camera_env_value KAMRUI_LAN_IP)"
    if ! is_ipv4 "$guest_ip" || ! is_ipv4 "$kamrui_ip"; then
      echo "camera.env is missing a valid guest or KAMRUI LAN IPv4 for RTMP" >&2
      exit 1
    fi
    if ufw status numbered | grep -F "$guest_ip" | grep -F "$kamrui_ip" | grep -Eq '1935(/tcp)?'; then
      ufw --force delete allow in from "$guest_ip" to "$kamrui_ip" port 1935 proto tcp
    else
      echo "no exact guest RTMP UFW rule is present"
    fi
    ufw status numbered
    ;;
  ufw-show)
    exec ufw status numbered
    ;;
  *)
    echo "unknown subcommand: $cmd" >&2
    echo "allowed: $ALLOWED" >&2
    exit 2
    ;;
esac
