[Unit]
Description=MBFD camera recording session %i
After=network-online.target mbfd-mediamtx.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=2

[Service]
Type=simple
User=mbfd-recording
Group=mbfd-recording
WorkingDirectory=/mnt/data/recordings
EnvironmentFile=/run/mbfd-camera-recording/%i.env
ExecStart=/usr/local/libexec/mbfd-camera-recording-run %i
# Never restart automatically: the runner uses -n and a fixed per-session
# pattern, so a failed unit remains preserved for explicit recovery rather than
# risking segment reuse.
Restart=no
KillMode=control-group
KillSignal=SIGINT
FinalKillSignal=SIGKILL
SendSIGKILL=yes
TimeoutStopSec=20
UMask=0007
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mbfd-camera-recording-%i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/mnt/data/recordings /run/mbfd-camera-recording
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
