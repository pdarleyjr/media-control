[Unit]
Description=MBFD camera recording session %i
After=network-online.target mbfd-mediamtx.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=2

[Service]
Type=simple
User=mbfd-recording
Group=mbfd-recording
WorkingDirectory=/mnt/data/recordings
EnvironmentFile=/run/mbfd-camera-recording/%i.env
ExecStart=/usr/local/libexec/mbfd-camera-recording-run %i
# This template is installed dormant until the API owns its complete env-file
# lifecycle. Automatic restart would reuse the %03d sequence; older runners
# could overwrite segment 000 and the fail-closed runner cannot safely resume.
# A failed session must therefore remain failed for explicit recovery.
Restart=no
KillMode=control-group
KillSignal=SIGINT
FinalKillSignal=SIGKILL
SendSIGKILL=yes
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mbfd-camera-recording-%i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/data/recordings /run/mbfd-camera-recording
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
