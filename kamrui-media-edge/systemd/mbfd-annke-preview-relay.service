[Unit]
Description=MBFD ANNKE preview stream relay (102 -> MediaMTX)
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=peter
Group=peter
EnvironmentFile=/etc/mbfd/media-stack/camera.env
ExecStart=/opt/mbfd/media-stack/annke-preview-relay.sh
Restart=always
RestartSec=5s
TimeoutStopSec=10s
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
