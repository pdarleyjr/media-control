[Unit]
Description=MBFD Camera Control API
After=network-online.target docker.service mbfd-mediamtx.service
Wants=network-online.target

[Service]
Type=simple
User=peter
Group=peter
WorkingDirectory=/opt/mbfd/media-stack/camera-api
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5s
Environment=NODE_ENV=production
# The unprivileged API invokes only the root-owned, argument-validating
# mbfd-recording-admin helper through its exact sudoers allowlist. Linux blocks
# that single broker when NoNewPrivileges=true; the recorder unit itself keeps
# NoNewPrivileges=true and the remaining confinement controls.
NoNewPrivileges=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
