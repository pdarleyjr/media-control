# /etc/mbfd/media-stack/camera.env  (mode 0600, NEVER committed with real values)
# Camera RTSP URLs (used only by MediaMTX mediamtx.yml generation)
ANNKE_MAIN_RTSP_URL=rtsp://USER:PASS@192.168.1.226:554/Streaming/Channels/101
ANNKE_PREVIEW_RTSP_URL=rtsp://USER:PASS@192.168.1.226:554/Streaming/Channels/102
# Camera Control API
CAMERA_API_PORT=8200
CAMERA_API_TOKEN=changeme-long-random
# Shared only with Media Control. Used to sign destructive service requests;
# do not reuse CAMERA_API_TOKEN.
CAMERA_SERVICE_SIGNING_SECRET=changeme-separate-long-random
CAMERA_SERVICE_SIGNING_KEY_ID=media-control
CAMERA_SERVICE_SIGNING_KEY_VERSION=v1
# Rotation overlap: configure all three previous-key values temporarily, then
# remove them after every Media Control instance uses the new current key.
CAMERA_SERVICE_PREVIOUS_SIGNING_SECRET=
CAMERA_SERVICE_PREVIOUS_SIGNING_KEY_ID=
CAMERA_SERVICE_PREVIOUS_SIGNING_KEY_VERSION=
# Recording storage
RECORDING_DIR=/mnt/data/recordings
# The independent systemd unit remains the default. To select Docker, provide
# an immutable image reference such as registry/name@sha256:<64 hex chars>.
RECORDING_BACKEND=systemd
RECORDING_DOCKER_IMAGE=
# Synchronization to GMKtec (LAN-primary + Tailscale fallback)
GMKTEC_SYNC_DEST=mbfd@192.168.1.116:/mnt/mbfd-storage/mbfd-broadcasts
GMKTEC_LAN_IP=192.168.1.116
GMKTEC_TAILSCALE_IP=100.81.154.123
# PeerTube livestream ingest
PEERTUBE_BASE_URL=https://videos.mbfdhub.com
PEERTUBE_ACCESS_TOKEN=changeme-peertube-oauth-token
PEERTUBE_RTMP_URL=rtmp://100.81.154.123:19350/live
PEERTUBE_STREAM_KEY=changeme-peertube-live-stream-key
PEERTUBE_LIVE_VIDEO_UUID=changeme-peertube-live-video-uuid
