--- a/scripts/operations/mbfd-ecosystem-backup.sh
+++ b/scripts/operations/mbfd-ecosystem-backup.sh
@@ -88,9 +88,24 @@
     log "snapshotting SQLite database: $label"
     sqlite3 "$source" ".timeout 10000" ".backup '$output'"
     integrity="$(sqlite3 "$output" 'PRAGMA integrity_check;')"
     [[ "$integrity" == ok ]] || fail "$label SQLite integrity check failed"
 }
-
+
+sqlite_backup_path() {
+    local source="$1" label="$2"
+    local output quick integrity foreign_keys
+    output="$stage/sqlite/$label.sqlite"
+    [[ -s "$source" ]] || fail "SQLite source missing: $source"
+    log "snapshotting path-backed SQLite database: $label"
+    sqlite3 "$source" ".timeout 10000" ".backup '$output'"
+    quick="$(sqlite3 "$output" 'PRAGMA quick_check;')"
+    [[ "$quick" == ok ]] || fail "$label SQLite quick check failed"
+    integrity="$(sqlite3 "$output" 'PRAGMA integrity_check;')"
+    [[ "$integrity" == ok ]] || fail "$label SQLite integrity check failed"
+    foreign_keys="$(sqlite3 "$output" 'PRAGMA foreign_key_check;')"
+    [[ -z "$foreign_keys" ]] || fail "$label SQLite foreign key check failed"
+}
+
 dump_postgres mbfd-hub-pgsql mbfd-hub
 dump_postgres mbfd-postgres nextcloud
 dump_postgres vac-postgres vacation
